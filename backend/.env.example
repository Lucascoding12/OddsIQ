DATABASE_URL=postgresql+asyncpg://oddsiq:oddsiq@localhost:5432/oddsiq
REDIS_URL=redis://localhost:6379
ODDS_API_KEY=your_key_here
ODDS_API_BASE=https://api.the-odds-api.com/v4
POLL_INTERVAL_SECONDS=120

# Poller — credit cost per sport request = (#markets) × (#regions)
ODDS_MARKETS=h2h,spreads,totals
ODDS_REGIONS=us
# Explicit books override regions; every 10 books = 1 region of cost.
# Default: 5 sharp books (Pinnacle, BetOnline, LowVig, Novig, ProphetX) + 15 US books.
# ODDS_BOOKMAKERS=pinnacle,betonlineag,lowvig,novig,prophetx,draftkings,fanduel,...
# Empty = auto-discover in-season sports (free). Or e.g. americanfootball_nfl,basketball_nba
ODDS_SPORTS=
ODDS_MAX_SPORTS=4
ODDS_CREDIT_RESERVE=25

# Arb scanner
ARB_MAX_QUOTE_AGE_SECONDS=1800
ARB_INCLUDE_LIVE=false
ARB_NEAR_MISS_PCT=-1.0

# +EV: keep bets with at least this edge (%) over the sharp fair line
EV_FLOOR_PCT=0.0

# Locks POST /api/v1/admin/poll; send it as the X-Admin-Token header
ADMIN_TOKEN=
